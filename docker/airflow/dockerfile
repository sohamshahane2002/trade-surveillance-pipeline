FROM apache/airflow:2.8.1-python3.10

# Docker CLI only (talks to the host daemon through the mounted socket)
COPY --from=docker:26-cli /usr/local/bin/docker /usr/local/bin/docker

RUN pip install --no-cache-dir \
    kafka-python-ng \
    loguru \
    python-dotenv \
    faker

RUN python -m venv /home/airflow/dbt_venv && \
    PIP_USER=false /home/airflow/dbt_venv/bin/pip install --no-cache-dir \
    --only-binary=duckdb \
    dbt-duckdb